{
  "name": "weixin-channels-video",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": "./src/core.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release:package": "node scripts/build.mjs --release",
    "test": "node --test tests/*.test.mjs",
    "start": "node server/index.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:build": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir dist/worker",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
