{
  "manifest_version": 3,
  "name": "视频号分享链接解析",
  "version": "0.1.1",
  "description": "在本地解析视频号分享链接并下载视频。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "declarativeNetRequestWithHostAccess", "nativeMessaging", "storage", "offscreen", "alarms"],
  "host_permissions": [
    "https://yuanbao.tencent.com/*",
    "https://channels.weixin.qq.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://yuanbao.tencent.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["yuanbao-frame.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "解析视频号分享链接",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
